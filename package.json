{
  "name": "froglabel",
  "private": true,
  "version": "0.1.1",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:ce": "node scripts/build-ce-assets.mjs",
    "build:pages": "node scripts/build-pages-assets.mjs",
    "build:enterprise-bundle": "node scripts/build-enterprise-bundle.mjs",
    "package:pages": "python scripts/package_pages.py",
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/property tests/protocol",
    "test:component": "vitest run tests/component",
    "test:e2e": "playwright test",
    "test:e2e:agent": "node scripts/test-e2e-agent.mjs",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:pages:agent": "node scripts/test-pages-agent.mjs",
    "test:ce:agent": "node scripts/test-ce-browser-agent.mjs",
    "test:ce:served": "node scripts/test-ce-served-agent.mjs",
    "test:enterprise:inline": "node scripts/test-enterprise-inline-agent.mjs",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-build-size.mjs"
  },
  "size-limit": [
    {
      "name": "JS bundle",
      "path": "dist/assets/*.js",
      "limit": "150 KB"
    },
    {
      "name": "CSS bundle",
      "path": "dist/assets/*.css",
      "limit": "10 KB"
    }
  ],
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@sparticuz/chromium": "149.0.0",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.3.0",
    "globals": "^17.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.1.4",
    "vitest": "^3.2.4"
  }
}
