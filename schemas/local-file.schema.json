{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://froglabel.local/schemas/local-file.schema.json",
  "title": "FrogLabel Local File V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "audio", "catalogSnapshot", "document"],
  "properties": {
    "kind": { "const": "froglabel.local-file" },
    "schemaVersion": { "const": 1 },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sizeBytes",
        "durationSeconds",
        "sampleRateHz",
        "channelCount",
        "fingerprint"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1, "maxLength": 512 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "mimeType": { "type": "string", "maxLength": 128 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
        "sampleRateHz": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 192000
        },
        "channelCount": { "type": "integer", "minimum": 1, "maximum": 2 },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value", "scope"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "scope": { "const": "file-bytes" }
          }
        }
      }
    },
    "catalogSnapshot": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "https://froglabel.local/schemas/species.schema.json" }
    },
    "document": {
      "oneOf": [
        { "$ref": "https://froglabel.local/schemas/document.schema.json" },
        { "type": "null" }
      ]
    }
  }
}
