{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://froglabel.local/schemas/task-data.schema.json",
  "title": "FrogLabel Host Data V1",
  "oneOf": [
    { "type": "string", "minLength": 1, "maxLength": 8192 },
    {
      "type": "object",
      "additionalProperties": true,
      "required": ["froglabel"],
      "properties": {
        "froglabel": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "froglabelConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion"],
          "properties": {
            "schemaVersion": { "const": 1 },
            "audio": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "filename": { "type": "string", "minLength": 1, "maxLength": 512 },
                "mimeType": { "type": "string", "minLength": 1, "maxLength": 128 },
                "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
                "sampleRateHz": { "type": "number", "exclusiveMinimum": 0, "maximum": 192000 }
              }
            }
          }
        }
      }
    }
  ]
}
