{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://froglabel.local/schemas/species.schema.json",
  "title": "FrogLabel Species Entry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "speciesId",
    "code",
    "speciesName",
    "addedAfterInitialization",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "froglabel.species" },
    "speciesId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "code": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "speciesName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "scientificName": { "type": "string", "minLength": 1, "maxLength": 256 },
    "externalTaxon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "id"],
      "properties": {
        "authority": { "type": "string", "minLength": 1, "maxLength": 64 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "addedAfterInitialization": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
